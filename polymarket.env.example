# ОБРАЗЕЦ настроек локального исполнителя. Скопируй в polymarket.env и заполни.
# polymarket.env НЕ коммитится (в .gitignore) — приватный ключ остаётся ТОЛЬКО на твоём ПК.
#
#   cp polymarket.env.example polymarket.env      # затем открой и впиши ключ
#
# ─────────────────────────────────────────────────────────────────────────────
# Режим (по возрастанию доверия — начинай с dry!):
#   dry   — ничего не шлём, печатаем «что бы купили». Ключ НЕ нужен. Так и стартуй.
#   smoke — ровно ОДНА живая сделка на PER_TRADE_USD и стоп (проверить ключ+API+филл).
#   live  — реальное исполнение в рамках лимитов ниже.
MODE=dry

# Приватный ключ кошелька Polygon (0x…, 64 hex). НУЖЕН только для smoke/live.
# НИКОМУ не показывай, не вставляй в чат, не коммить. В dry можно оставить пустым.
# Если вход на Polymarket был через почту/Google/Magic — это ключ ПОДПИСАНТА (export из Magic).
PRIVATE_KEY=

# ТИП АККАУНТА. Оставь пусто/0, если завёл ОТДЕЛЬНЫЙ кошелёк и кинул USDC прямо на него (EOA).
# Если вошёл на polymarket.com через почту/Google/Magic — деньги на ПРОКСИ-кошельке:
#   SIGNATURE_TYPE=1  и  FUNDER=<твой адрес на polymarket.com> (публичный 0x…, НЕ ключ).
# Если через браузерный кошелёк (MetaMask и т.п.): SIGNATURE_TYPE=2 и FUNDER=<адрес прокси>.
SIGNATURE_TYPE=0
FUNDER=

# Сколько реально завёл на кошелёк (USDC на Polygon). Бот не потратит больше.
DEPOSIT=100

# Размер одной сделки в долларах. Начни с $1 — мелочь заполняется мгновенно.
PER_TRADE_USD=1

# Максимум трат за сутки (тормоз против серии на плохом дне).
DAILY_MAX_USD=20

# Не входим в рынки дороже этой цены (у края апсайда нет).
MAX_PRICE=0.92

# Какую группу копируем (core = наша отобранная восьмёрка+ под реал).
GROUP=core

# Как часто опрашивать сигналы, сек.
POLL_SEC=30

# Адрес нашего сервера сигналов (менять не нужно).
SERVER=http://144.31.197.121:5000
