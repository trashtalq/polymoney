# ОБРАЗЕЦ настроек локального исполнителя. Скопируй в polymarket.env и заполни.
# polymarket.env НЕ коммитится (в .gitignore) — приватный ключ остаётся ТОЛЬКО на твоём ПК.
#
#   cp polymarket.env.example polymarket.env      # затем открой и впиши ключ
#
# ─────────────────────────────────────────────────────────────────────────────
# Режим (по возрастанию доверия — начинай с dry!):
#   dry   — ничего не шлём, печатаем «что бы купили». Ключ НЕ нужен. Так и стартуй.
#   smoke — ровно ОДНА живая сделка на PER_TRADE_USD и стоп (проверить ключ+API+филл).
#   live  — реальное исполнение в рамках лимитов ниже.
MODE=dry

# Приватный ключ ПОДПИСАНТА (0x…, 64 hex). НУЖЕН только для smoke/live.
# При входе через почту/Google/Magic — это ключ, экспортированный из Magic.
# НИКОМУ не показывай, не вставляй в чат, не коммить. В dry можно оставить пустым.
PRIVATE_KEY=

# FUNDER — твой адрес ДЕПОЗИТА на polymarket.com (публичный 0x…, НЕ ключ), туда закинут USDC.
# ОБЯЗАТЕЛЕН для smoke/live: новый SDK торгует через «deposit wallet flow» (ключ подписывает,
# деньги на этом адресе). Найти: профиль на polymarket.com -> адрес кошелька.
FUNDER=

# Максимум денег В ОТКРЫТЫХ ПОЗИЦИЯХ ОДНОВРЕМЕННО (не пожизненный расход!). Когда позиция
# закрывается/продаётся — этот бюджет освобождается сам, бот снова может входить. Считается
# по реальным холдингам с чейна. Ставь ~= сколько USDC реально на кошельке (или чуть меньше).
DEPOSIT=100

# Размер одной сделки в долларах. Начни с $1 — мелочь заполняется мгновенно.
PER_TRADE_USD=1

# Максимум трат за сутки, брутто (тормоз-троттл против серии входов на плохом дне; сбрасывается
# в полночь). Это НЕ про баланс — только скорость трат за день. Хочешь активнее — подними.
DAILY_MAX_USD=20

# Не входим в рынки дороже этой цены (у края апсайда нет).
MAX_PRICE=0.92

# Не входим ДЕШЕВЛЕ этой цены — дешёвые лонгшоты (2-10¢ «да») чаще всего гаснут в ноль, а копи-лаг
# и дисперсия на них съедают реал (анализ 2026-07-13: −$14 на Trump-фразах по 1-3¢). 0.12 = разумно;
# 0 = без нижнего порога.
MIN_PRICE=0.12

# Не входить в одну и ту же позицию (токен) больше N раз — предохранитель от
# переусердствования с усреднением на реальные деньги.
MAX_ENTRIES_PER_POS=2

# Максимум денег В ОТКРЫТЫХ ПОЗИЦИЯХ, скопированных с ОДНОГО кошелька (не расход за сутки!).
# Частильщик из ядра входит снова, только когда его прошлые позиции закрылись (в плюс/минус —
# неважно), поэтому он не выедает бюджет, а деньги распределяются по всей когорте. Освобождается
# сам по мере закрытия позиций (считается по реальным холдингам с чейна).
MAX_PER_WALLET_DAY=5

# Фильтр по дате резолва рынка. 0 = ВЫКЛ (рекомендуется на этапе сбора статистики:
# цели флипают и долгие рынки, а капитал освобождают ВЫХОДЫ вслед за целью, не пред-фильтр).
# Поставь >0 (напр. 7), только если хочешь жёстко ограничить горизонт входов.
MAX_RESOLVE_DAYS=0

# МИРРОРИНГ ВЫХОДОВ: как только кошелёк-цель продаёт >= этой доли своего холдинга,
# бот продаёт СВОЮ позицию ЦЕЛИКОМ — выходим сразу вслед за целью, не ждём резолва.
# 0.1 = выходим на первую значимую продажу цели (рекомендуется); 0.01 = на ЛЮБУЮ продажу;
# 0.5 = только когда цель вышла на половину+. Наши позиции мелкие ($1-2) -> продаём всё сразу.
EXIT_MIN_FRAC=0.1

# Какую группу копируем (core = наша отобранная восьмёрка+ под реал).
GROUP=core

# Как часто опрашивать сигналы, сек.
POLL_SEC=30

# ДОГОН ПОД ЗАДЕРЖКУ ("платим за лаг"): если рынок ушёл вверх от цены сигнала, умножаем ставку на
# текущая/цена_цели -> берём СТОЛЬКО ЖЕ долей, как цель (тот же payout, как будто вошли по её цене).
# ВАЖНО: на выигрыше даёт тот же приз, НО риск на проигрыше растёт пропорц. -> математически это НЕ
# улучшает эдж (Келли говорит наоборот — уменьшать размер при худшей цене). Сначала протестируй на
# ТЕНЕВОМ. 0=выкл (обычная фикс-ставка, рекомендуется), 1=вкл.
CHASE_MATCH=0
CHASE_MAX_MULT=2        # потолок множителя (не платить больше N× базовой ставки за догон)

# Адрес нашего сервера сигналов (менять не нужно).
SERVER=http://144.31.197.121:5000

# ─── ТЕНЕВОЙ (PAPER) РЕЖИМ — честный замер «а что было бы на $15k» ───
# Запусти ВТОРЫМ процессом двойным кликом по paper.bat (он ставит MODE=paper). Тот же бот, те же
# гварды/задержки/сигналы, но «покупает» по РЕАЛЬНЫМ кэфам в ВИРТУАЛЬНЫЙ банк — БЕЗ денег и ключа.
# Каждый цикл печатает [PAPER] банк/PnL. Состояние — paper15k_state.json (удали, чтобы обнулить).
# Все PAPER_*-лимиты НЕЗАВИСИМЫ от реала (в пульте — кнопка «⚙ Настройки теневого»). Не заданы —
# берётся общий аналог/дефолт. Так теневой можно крутить с другими ставками/ценами, чем реал.
PAPER_BANKROLL=15000            # виртуальный стартовый банк
PAPER_PER_TRADE=10              # ставка на позицию (как планируешь на реале)
PAPER_MAX_PER_WALLET=300        # лимит экспозиции на один кошелёк (масштаб под большой банк)
PAPER_MAX_PRICE=0.92            # свои границы цены входа для теневого
PAPER_MIN_PRICE=0.12
PAPER_MAX_ENTRIES_PER_POS=3     # входов в одну позу
PAPER_MAX_AGE_SEC=300           # не копировать сигналы старше (в пульте — в минутах)
PAPER_MAX_RESOLVE_DAYS=0        # горизонт резолва, 0=выкл
PAPER_EXIT_MIN_FRAC=0.1         # выход вслед за целью
PAPER_POLL_SEC=30               # опрос сервера, сек

# Токен ленты сигналов. Должен совпадать с SIGNALS_TOKEN в серверном .env (см. docker-compose.yml).
# Если на сервере токен не задан — лента открыта, и это поле можно оставить пустым.
SIGNALS_TOKEN=

# ─── TELEGRAM-УВЕДОМЛЕНИЯ (вход/выход/итоги банкролла) ───
# По умолчанию ВЫКЛЮЧЕНО — ничего никуда не уходит, пока сам не включишь.
# Как включить:
#   1) в Telegram напиши @BotFather -> /newbot -> получишь ТОКЕН
#   2) создай канал, добавь бота АДМИНОМ (иначе постить не сможет)
#   3) TG_CHAT = @имя_канала (публичный) или числовой id (приватный)
# ТОКЕН — СЕКРЕТ: он только здесь, в репо НИКОГДА (файл в .gitignore).
TG_ENABLED=0
TG_TOKEN=
TG_CHAT=
TG_TAG=                 # префикс к сообщениям, напр. #реал или #тест (удобно, если контуров несколько)
TG_SUMMARY_H=24         # как часто слать ИТОГ банкролла, часов (0 = не слать)

